{
  "expo": {
    "name": "WhatNow",
    "slug": "whatnow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "whatnow",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FDF6EE",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.shreyanshojha.whatnow",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WhatNow uses your location only to tailor suggestions to your weather and nearby places.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.shreyanshojha.whatnow",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDF6EE"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FDF6EE"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WhatNow uses your location only to tailor suggestions to your weather and nearby places."
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
